import pandas as pd
import numpy as np
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans
from scipy.spatial.distance import euclidean

df = pd.read_csv("data_test_clustering_A1.csv")

start, end = 20, 80
segment = df.iloc[42482:43476]

#if segment.shape[0] == 0:
    #raise ValueError("Selected index range is outside the dataset")

pca = PCA(n_components=2)
pca_data = pca.fit_transform(segment)

idx_242 = pca_data[11]
idx_138 = pca_data[832]

pca_242_pc1 = round(idx_242[0], 3)
pca_138_pc2 = round(idx_138[1], 3)

distance = round(euclidean(idx_242, idx_138), 3)

kmeans = KMeans(n_clusters=4, random_state=0)
labels = kmeans.fit_predict(segment)

num_clusters = len(np.unique(labels))

label_242 = int(labels[11])
label_138 = int(labels[832])

print("Distinct clusters:", num_clusters)
print("Index 242 - most significant PCA value:", pca_242_pc1)
print("Index 138 - second most significant PCA value:", pca_138_pc2)
print("Euclidean distance:", distance)
print("Cluster label for index 242:", label_242)
print("Cluster label for index 138:", label_138)




